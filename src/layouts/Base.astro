---
import "../styles/global.css";
import { SITE, content, type Lang } from "../data/content";

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = content[lang];
const url = new URL(c.path, SITE.url).href;
const alt = new URL(c.altPath, SITE.url).href;
const es = new URL("/", SITE.url).href;
const en = new URL("/en/", SITE.url).href;
const og = new URL("/og.png", SITE.url).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${SITE.url}/#person`,
      name: SITE.name,
      jobTitle: lang === "es" ? "Desarrollador Web Full Stack" : "Full Stack Web Developer",
      url: SITE.url,
      email: SITE.email,
      telephone: SITE.phone,
      address: { "@type": "PostalAddress", addressLocality: "Lima", addressCountry: "PE" },
      sameAs: [SITE.github, SITE.linkedin],
      knowsLanguage: ["es", "en"],
      knowsAbout: ["React", "Next.js", "Laravel", "Node.js", "TypeScript", "Docker", "WordPress", "SEO"],
    },
    {
      "@type": "ProfessionalService",
      "@id": `${SITE.url}/#service`,
      name: `${SITE.name} - ${lang === "es" ? "Desarrollo Web Freelance" : "Freelance Web Development"}`,
      url,
      image: og,
      provider: { "@id": `${SITE.url}/#person` },
      areaServed: "Worldwide",
      serviceType: c.services.map((s) => s.t),
    },
    {
      "@type": "FAQPage",
      mainEntity: c.faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};
---
<!doctype html>
<html lang={c.htmlLang} class="scroll-pt-20">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#07070d" />
    <meta name="color-scheme" content="dark" />
    <title>{c.title}</title>
    <meta name="description" content={c.description} />
    <meta name="author" content={SITE.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="es" href={es} />
    <link rel="alternate" hreflang="en" href={en} />
    <link rel="alternate" hreflang="x-default" href={es} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={c.title} />
    <meta property="og:description" content={c.description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={c.htmlLang.replace("-", "_")} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={c.title} />
    <meta name="twitter:description" content={c.description} />
    <meta name="twitter:image" content={og} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="font-sans">
    <slot />
  </body>
</html>
